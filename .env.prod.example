# Keel production environment. Copy to `.env.prod` and fill in the values.
# Never commit the real file because it contains credentials.
# The production Compose stack requires Docker Compose 2.30 or newer and reads
# this file in raw mode, so `$` characters in credentials remain literal.

# Reverse-proxy hostnames live separately in `.env.caddy`, copied from
# `.env.caddy.example`. Keeping them separate prevents Caddy from inheriting
# any application credentials in this file.

# Optional built-in public project/news site. Leave this empty to serve only
# the notebook. The standalone keelnotes.com product site is not part of this
# runtime.
KEEL_SITE_HOSTS=
KEEL_NOTES_URL=https://notes.example.com
# KEEL_SITE_NAME="My projects"
# KEEL_SITE_TAGLINE="Projects, notes, and experiments."

# Leave empty for a single hostname. If you deliberately serve the built-in
# site and notebook on sibling subdomains, use the shared parent domain.
KEEL_COOKIE_DOMAIN=

# The HTTPS address people type. WebAuthn values must match it exactly.
KEEL_WEBAUTHN_RP_ID=notes.example.com
KEEL_WEBAUTHN_ORIGIN=https://notes.example.com
KEEL_PUBLIC_URL=https://notes.example.com

# Set to 1 only when a reverse proxy you control sets the forwarding headers.
KEEL_TRUST_PROXY=1
# KEEL_TRUSTED_PROXY_HOPS=2

# After creating the administrator over private access, enable this hard stop
# before exposing the deployment. An email allowlist does not verify ownership
# of a password-registration address by itself.
KEEL_ALLOWED_EMAILS=you@example.com
KEEL_DISABLE_SIGNUP=1

# Hosted owner claim: generate `openssl rand -hex 32`, keep the result in the
# platform secret store, and paste it into the write-only claim field after
# signing in. Remove this environment value and restart Keel after the claim.
KEEL_OWNER_BOOTSTRAP_TOKEN=
# For fully automated deployments, a stable database User.id may be pinned
# instead. It overrides every persisted claim.
# KEEL_OWNER_USER_ID=

# Optional Google sign-in and Google Drive backup connection. Add this exact
# sign-in callback and the two other callbacks shown in Settings to the client:
# https://notes.example.com/api/auth/google/callback
# https://notes.example.com/api/account/google/callback
# https://notes.example.com/api/cloud/callback/google
# Environment credentials override and lock Settings -> Integrations.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Microsoft OneNote mirror and OneDrive backup connection.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
KEEL_SYNC_SECRET=

# Required when PostgreSQL stores credentials managed through Settings,
# including OAuth, cloud-connection, and scheduled-backup secrets.
# Generate 32 random bytes and encode them as 64 hex characters, 43-character
# unpadded base64url, or 44-character standard base64. Retain this unchanged in
# the host secret store. Never commit it or include it in database backups.
KEEL_SERVER_SECRET_KEY=

# Optional Cloudflare R2 destination for continuous Litestream replication.
LITESTREAM_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
LITESTREAM_R2_BUCKET=keel-notes
LITESTREAM_R2_ACCESS_KEY_ID=
LITESTREAM_R2_SECRET_ACCESS_KEY=

# Optional host override for Keel's encrypted scheduled snapshots. A nonempty
# value locks the write-only Settings panel. Keep it in a password manager and
# test a restore before trusting the backup.
KEEL_BACKUP_PASSPHRASE=
