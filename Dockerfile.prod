# Keel - always-on production image.
#
# Runs the app under Litestream, which streams every SQLite write to Cloudflare
# R2 continuously. On a fresh host with no local database, the entrypoint first
# restores the latest replica from R2 (disaster recovery), then applies any
# pending schema migrations, then serves - so upgrades and host replacement
# never lose data.
#
# Build/run via docker-compose.prod.yml (adds Caddy for automatic HTTPS).
FROM node:22-slim

# Prisma needs OpenSSL; wget/ca-certificates fetch Litestream. The host backup
# service uses SQLite's online-backup command inside this image so the copied
# database is transactionally consistent while Keel remains live.
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends openssl ca-certificates wget sqlite3 \
    && rm -rf /var/lib/apt/lists/*

# Litestream (continuous SQLite replication to R2).
ARG LITESTREAM_VERSION=0.3.13
ARG TARGETARCH
RUN case "$TARGETARCH" in \
      amd64) LITESTREAM_SHA256="9b05043523c1fb1c4f9800623adf0015683da7fdd55e19b9fe5d28f63fae96b4" ;; \
      arm64) LITESTREAM_SHA256="073aceebd2bbd58213aad2e05fdf4667ff4ca1140d0be6df308859798c74e8e8" ;; \
      *) echo "Unsupported Litestream architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && wget -qO /tmp/litestream.deb \
      "https://github.com/benbjohnson/litestream/releases/download/v${LITESTREAM_VERSION}/litestream-v${LITESTREAM_VERSION}-linux-${TARGETARCH}.deb" \
    && echo "$LITESTREAM_SHA256  /tmp/litestream.deb" | sha256sum -c - \
    && dpkg -i /tmp/litestream.deb \
    && rm /tmp/litestream.deb

WORKDIR /app

COPY package.json package-lock.json ./
COPY prisma ./prisma
RUN npm ci --no-audit --no-fund

COPY . .
ENV NEXT_TELEMETRY_DISABLED=1 NODE_ENV=production
RUN npm run build

COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# The database lives on a mounted volume at /data (see compose); DATABASE_URL
# and the litestream.yml path both point there.
# HOSTNAME must be an explicit bind address: without this, Docker's default
# HOSTNAME (the container ID) leaks in and the server binds only eth0 -
# loopback refuses, the wget healthcheck fails forever, and anything gated on
# service_healthy (the Cloudflare tunnel) never starts.
ENV PORT=3000 \
    HOSTNAME=0.0.0.0 \
    DATABASE_URL="file:/data/keel.db" \
    NOPIN_UPLOAD_DIR=/data/uploads

# A fresh named volume mounted over /data inherits the ownership of this image
# path. Create it for the unprivileged runtime user so the first boot can make
# the database, uploads, backups, and managed-secret sidecar without a root
# entrypoint or a one-off host chown.
RUN mkdir -p /data/backups /data/uploads && chown -R node:node /data
USER node
EXPOSE 3000

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
