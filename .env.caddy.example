# Keel reverse-proxy environment. Copy this file to `.env.caddy`.
#
# This file belongs only to Caddy. Do not add database URLs, OAuth secrets,
# backup passphrases, R2 credentials, or other application settings here.
# Each hostname needs DNS pointing at this server. Separate multiple names with
# spaces, for example: notes.example.com www.notes.example.com
KEEL_DOMAINS=notes.example.com
