# SQLite for local development. Swap for a PostgreSQL URL in production
# (also change the datasource provider in prisma/schema.prisma to "postgresql").
DATABASE_URL="file:./dev.db"

# Docker Compose reads this file as raw application environment. It overrides
# DATABASE_URL, PORT, HOST, and KEEL_CLAIM_REQUIRED inside the container, but
# passes the remaining settings through unchanged. The published socket is
# loopback-only; change just the host-side port with KEEL_HOST_PORT.
# KEEL_HOST_PORT=3000

# Who runs this instance - gates the /admin site CMS, registration controls and
# the Cloudflare tunnel. Distinct from workspace ownership (every account owns
# its own workspace). For a local source install, register first, then generate
# the one-use command from "Claim this server" in Welcome or Settings. The
# command confirms host access through fresh sudo authorization.
#
# Hosted PostgreSQL: set one high-entropy token, paste it into the write-only
# claim field after signing in, then remove it from the host and restart Keel.
# Generate one with: openssl rand -hex 32
# KEEL_OWNER_BOOTSTRAP_TOKEN="64-hex-characters"
#
# Automated operators may instead pin a stable database User.id. This is the
# highest-priority authority and must be kept in the host secret/config store.
# KEEL_OWNER_USER_ID="database-user-id"
#
# Deprecated compatibility selector. This never authorizes a password-created
# account; it can bind only a matching Google-verified account, then persists
# that stable User.id. Prefer one of the claim methods above.
# KEEL_OWNER_EMAIL="you@example.com"

# Optional host override for automatic encrypted backups. The claimed owner can
# instead save a write-only managed value in Settings -> Scheduled backup
# secret. A nonempty value here overrides and locks that panel. Keep your own
# recovery copy in a password manager:
# KEEL_BACKUP_PASSPHRASE="change-me-to-a-strong-passphrase"

# Google sign-in + Google Drive backups (see docs/CLOUD.md for setup):
# The claimed owner may save these from Settings -> Integrations instead. Values
# set here are operator overrides and make that provider read-only in Settings.
# GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="..."

# OneDrive backups (Microsoft Entra app registration, see docs/CLOUD.md):
# MS_CLIENT_ID="..."
# MS_CLIENT_SECRET="..."

# PostgreSQL only: the 32-byte master key for managed server secrets saved from
# Settings, including OAuth, cloud-connection, and scheduled-backup credentials.
# Encode it as 64 hex characters, 43-character unpadded base64url, or 44-character
# standard base64. Keep it in the host secret store, never in Git or a database
# backup. SQLite creates a mode-0600 sidecar key automatically.
# KEEL_SERVER_SECRET_KEY="..."

# Optional secret for an external scheduler that triggers the read-only OneNote
# mirror. Send it in the X-Keel-Sync-Secret header. Use at least 32 characters.
# KEEL_SYNC_SECRET="..."

# The URL users type in their browser to reach this Keel. Behind ANY proxy or
# tunnel (Tailscale Serve, Cloudflare, Caddy, Docker) set this explicitly: it
# anchors OAuth callbacks, security-key origins and the setup guide's copy.
KEEL_PUBLIC_URL=http://localhost:3000


# In-app restart (Settings → Server) works by exiting and letting the service
# manager start Keel again. Detection is automatic for Docker/systemd/launchd;
# override with 1 (yes, restart me) or 0 (nothing will bring me back).
# KEEL_SUPERVISED=1
